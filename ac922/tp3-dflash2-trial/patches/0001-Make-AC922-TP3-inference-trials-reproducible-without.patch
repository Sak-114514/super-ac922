+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import os
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+
+from vllm.model_executor.models.qwen3_dflash_tp3_heads import (
+    replicate_dflash_tp3_weights,
+    validate_dflash_tp3_config,
+)
+
+
+def test_draft_config_and_missing_tensors():
+    config = SimpleNamespace(
+        num_attention_heads=36,
+        num_key_value_heads=9,
+        head_dim=128,
+        intermediate_size=17664,
+        hidden_size=5120,
+        vocab_size=248320,
+        num_hidden_layers=5,
+    )
+    validate_dflash_tp3_config(config)
+    config.num_key_value_heads = 8
+    with unittest.TestCase().assertRaisesRegex(ValueError, "num_key_value_heads=9"):
+        validate_dflash_tp3_config(config)
+    with unittest.TestCase().assertRaisesRegex(ValueError, "missing draft tensors"):
+        list(replicate_dflash_tp3_weights([]))
+
+
+def test_real_draft_attention_replication():
+    from safetensors import safe_open
+
+    if not (model_path := os.environ.get("AC922_DFLASH_TP3_TEST_MODEL")):
+        raise unittest.SkipTest("set AC922_DFLASH_TP3_TEST_MODEL")
+    prefix = "layers.0.self_attn"
+    names = [
+        f"{prefix}.{projection}.weight"
+        for projection in ("q_proj", "k_proj", "v_proj", "o_proj")
+    ]
+    with safe_open(
+        str(Path(model_path) / "model.safetensors"), framework="pt", device="cpu"
+    ) as handle:
+        weights = {name: handle.get_tensor(name) for name in names}
+    expanded = dict(
+        replicate_dflash_tp3_weights(weights.items(), require_complete=False)
+    )
+    q = weights[f"{prefix}.q_proj.weight"]
+    new_q = expanded[f"{prefix}.q_proj.weight"]
+    o = weights[f"{prefix}.o_proj.weight"]
+    new_o = expanded[f"{prefix}.o_proj.weight"]
+    assert new_q.shape == (4608, 5120)
+    assert new_o.shape == (5120, 4608)
+    assert torch.equal(new_q[4096:], q[:512])
+    assert torch.equal(new_o[:, :512] * 2, o[:, :512])
+    assert torch.equal(new_o[:, 512:4096], o[:, 512:])
+    assert torch.equal(new_o[:, 4096:], new_o[:, :512])
+    for projection in ("k_proj", "v_proj"):
+        old = weights[f"{prefix}.{projection}.weight"]
+        new = expanded[f"{prefix}.{projection}.weight"]
+        assert new.shape == (1152, 5120)
+        assert torch.equal(new[1024:], old[:128])
+
+    torch.manual_seed(13)
+    hidden = torch.randn(5120, dtype=torch.float64)
+    original_output = o.double() @ (q.double() @ hidden)
+    expanded_output = new_o.double() @ (new_q.double() @ hidden)
+    torch.testing.assert_close(expanded_output, original_output, rtol=0, atol=1e-8)
+
+
+if __name__ == "__main__":
+    test_draft_config_and_missing_tensors()
+    print("PASS test_draft_config_and_missing_tensors")
+    if os.environ.get("AC922_DFLASH_TP3_TEST_MODEL"):
+        test_real_draft_attention_replication()
+        print("PASS test_real_draft_attention_replication")
