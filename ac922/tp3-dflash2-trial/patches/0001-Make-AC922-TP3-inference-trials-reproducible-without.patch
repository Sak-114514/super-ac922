--- /dev/null
+++ b/vllm/model_executor/models/qwen3_dflash_tp3_heads.py
@@ -0,0 +1,85 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""In-memory TP3 expansion of the five-layer Qwen3.8 DFlash2 drafter."""
+
+from collections.abc import Iterable, Iterator
+
+import torch
+
+from .qwen3_5_tp3_heads import (
+    _pad_mlp_input,
+    _pad_mlp_output,
+    _repeat_input,
+    _repeat_output,
+)
+
+
+def validate_dflash_tp3_config(config: object) -> None:
+    expected = {
+        "num_attention_heads": 36,
+        "num_key_value_heads": 9,
+        "head_dim": 128,
+        "intermediate_size": 17664,
+        "hidden_size": 5120,
+        "vocab_size": 248320,
+        "num_hidden_layers": 5,
+    }
+    for key, value in expected.items():
+        if getattr(config, key, None) != value:
+            raise ValueError(f"AC922 TP3 DFlash2 requires {key}={value}")
+
+
+def replicate_dflash_tp3_weights(
+    weights: Iterable[tuple[str, torch.Tensor]],
+    *,
+    require_complete: bool = True,
+) -> Iterator[tuple[str, torch.Tensor]]:
+    """Copy KV group zero and its four queries; zero-pad each MLP."""
+    seen: set[tuple[int, str, str]] = set()
+    for name, tensor in weights:
+        parts = name.split(".")
+        if len(parts) != 5 or parts[0] != "layers" or parts[4] != "weight":
+            yield name, tensor
+            continue
+        layer = int(parts[1])
+        if not 0 <= layer < 5:
+            raise ValueError(f"unexpected DFlash2 draft layer: {name}")
+        branch, projection = parts[2:4]
+        transform = None
+        if branch == "self_attn":
+            if projection == "q_proj":
+                transform = _repeat_output(
+                    tensor, "weight", 5120, ((4096, 512),), dense_tail=(5120,)
+                )
+            elif projection in ("k_proj", "v_proj"):
+                transform = _repeat_output(
+                    tensor, "weight", 5120, ((1024, 128),), dense_tail=(5120,)
+                )
+            elif projection == "o_proj":
+                transform = _repeat_input(tensor, "weight", 5120, 4096, 512)
+        elif branch == "mlp":
+            if projection in ("gate_proj", "up_proj"):
+                transform = _pad_mlp_output(tensor, "weight")
+            elif projection == "down_proj":
+                transform = _pad_mlp_input(tensor, "weight")
+        if transform is None:
+            yield name, tensor
+            continue
+        seen.add((layer, branch, projection))
+        yield name, transform
+
+    if not require_complete:
+        return
+    expected = {
+        (layer, branch, projection)
+        for layer in range(5)
+        for branch, projections in (
+            ("self_attn", ("q_proj", "k_proj", "v_proj", "o_proj")),
+            ("mlp", ("gate_proj", "up_proj", "down_proj")),
+        )
+        for projection in projections
+    }
+    missing = expected - seen
+    if missing:
+        raise ValueError(f"AC922 TP3 DFlash2 is missing draft tensors: {missing}")
