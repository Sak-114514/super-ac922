diff --git a/vllm/model_executor/models/qwen3_5_tp3_heads.py b/vllm/model_executor/models/qwen3_5_tp3_heads.py
new file mode 100644
index 000000000..c862ff12c
--- /dev/null
+++ b/vllm/model_executor/models/qwen3_5_tp3_heads.py
@@ -0,0 +1,278 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Lossless TP3 head replication for the Qwen3.5 27B AWQ checkpoint.
+
+The checkpoint stays untouched. Each tensor is expanded before the regular
+quantized tensor-parallel loader sees it. This is deliberately specific to the
+24/4 attention and 16/48 GDN layout of this checkpoint.
+"""
+
+from collections.abc import Iterable, Iterator
+
+import torch
+
+
+def validate_tp3_head_config(config: object) -> list[str]:
+    text = getattr(config, "text_config", None)
+    if text is None:
+        raise ValueError("TP3 head replication requires a Qwen3.5 text_config")
+    expected = {
+        "num_attention_heads": 36,
+        "num_key_value_heads": 6,
+        "head_dim": 256,
+        "linear_num_key_heads": 18,
+        "linear_num_value_heads": 54,
+        "linear_key_head_dim": 128,
+        "linear_value_head_dim": 128,
+        "hidden_size": 5120,
+        "intermediate_size": 17664,
+    }
+    for key, value in expected.items():
+        if getattr(text, key, None) != value:
+            raise ValueError(f"TP3 head replication requires {key}={value}")
+    if not getattr(text, "attn_output_gate", False):
+        raise ValueError("TP3 head replication requires attention output gates")
+    layer_types = list(getattr(text, "layer_types", ()))
+    if len(layer_types) != 64 or layer_types.count("full_attention") != 16:
+        raise ValueError("TP3 head replication requires 16/48 hybrid layers")
+    if layer_types.count("linear_attention") != 48:
+        raise ValueError("TP3 head replication requires 48 GDN layers")
+    return layer_types
+
+
+def _shape_tensor(tensor: torch.Tensor, old: tuple[int, int], new: tuple[int, int]):
+    if tensor.shape != (2,) or tensor.tolist() != list(old):
+        raise ValueError(f"unexpected packed weight_shape: {tensor.tolist()}")
+    return tensor.new_tensor(new)
+
+
+def _repeat_output(
+    tensor: torch.Tensor,
+    suffix: str,
+    input_size: int,
+    segments: tuple[tuple[int, int], ...],
+    bits: int = 4,
+    dense_tail: tuple[int, ...] | None = None,
+) -> torch.Tensor:
+    old_output = sum(length for length, _ in segments)
+    new_output = old_output + sum(copy for _, copy in segments)
+    if suffix == "weight_shape":
+        return _shape_tensor(tensor, (old_output, input_size), (new_output, input_size))
+    output_pack = 8 if suffix == "weight_zero_point" else 1
+    if suffix == "weight_packed":
+        expected_width = input_size // (32 // bits)
+    elif suffix in ("weight_scale", "weight_zero_point"):
+        expected_width = input_size // 128
+    elif suffix in ("weight", "bias"):
+        expected_width = None
+    else:
+        raise ValueError(f"unsupported TP3 output tensor: {suffix}")
+    if tensor.shape[0] != old_output // output_pack:
+        raise ValueError(f"unexpected output size for {suffix}: {tensor.shape}")
+    if expected_width is not None and (
+        tensor.ndim != 2 or tensor.shape[1] != expected_width
+    ):
+        raise ValueError(f"unexpected packed shape for {suffix}: {tensor.shape}")
+    if (
+        suffix == "weight"
+        and dense_tail is not None
+        and tuple(tensor.shape[1:]) != dense_tail
+    ):
+        raise ValueError(f"unexpected dense shape for {suffix}: {tensor.shape}")
+    if suffix == "bias" and tensor.ndim != 1:
+        raise ValueError(f"unexpected bias shape: {tensor.shape}")
+    pieces = []
+    offset = 0
+    for length, copy in segments:
+        if length % output_pack or copy % output_pack or copy > length:
+            raise ValueError("unaligned TP3 output head copy")
+        length //= output_pack
+        copy //= output_pack
+        pieces.append(tensor.narrow(0, offset, length))
+        pieces.append(tensor.narrow(0, offset, copy))
+        offset += length
+    return torch.cat(pieces, dim=0)
+
+
+def _repeat_input(
+    tensor: torch.Tensor,
+    suffix: str,
+    output_size: int,
+    input_size: int,
+    copy_size: int,
+) -> torch.Tensor:
+    if suffix == "weight_shape":
+        return _shape_tensor(
+            tensor, (output_size, input_size), (output_size, input_size + copy_size)
+        )
+    if suffix == "weight_packed":
+        unit = 8  # Eight int4 input channels per int32.
+    elif suffix in ("weight_scale", "weight_zero_point"):
+        unit = 128  # One quantization group per 128 input channels.
+    elif suffix == "weight":
+        unit = 1
+    else:
+        raise ValueError(f"unsupported TP3 input tensor: {suffix}")
+    if input_size % unit or copy_size % unit:
+        raise ValueError("unaligned TP3 input head copy")
+    rows = output_size // (8 if suffix == "weight_zero_point" else 1)
+    if tensor.ndim != 2 or tensor.shape != (rows, input_size // unit):
+        raise ValueError(f"unexpected input shape for {suffix}: {tensor.shape}")
+    copy = tensor.narrow(1, 0, copy_size // unit)
+    rest = tensor.narrow(1, copy_size // unit, (input_size - copy_size) // unit)
+    if suffix in ("weight_scale", "weight"):
+        half = copy * 0.5
+        if not bool(torch.isfinite(copy).all()) or not torch.equal(half * 2, copy):
+            raise ValueError("TP3 output scale cannot be halved exactly")
+        copy = half
+    return torch.cat((copy, rest, copy), dim=1)
+
+
+def _pad_mlp_output(tensor: torch.Tensor, suffix: str) -> torch.Tensor:
+    old_output, added, input_size = 17408, 256, 5120
+    if suffix == "weight_shape":
+        return _shape_tensor(
+            tensor, (old_output, input_size), (old_output + added, input_size)
+        )
+    output_pack = 8 if suffix == "weight_zero_point" else 1
+    if suffix == "weight_packed":
+        width = input_size // 8
+    elif suffix in ("weight_scale", "weight_zero_point"):
+        width = input_size // 128
+    elif suffix == "weight":
+        width = input_size
+    else:
+        raise ValueError(f"unsupported TP3 MLP output tensor: {suffix}")
+    if tensor.shape != (old_output // output_pack, width):
+        raise ValueError(f"unexpected TP3 MLP output shape: {tensor.shape}")
+    fill = 1 if suffix == "weight_scale" else 0
+    pad = tensor.new_full((added // output_pack, width), fill)
+    return torch.cat((tensor, pad), dim=0)
+
+
+def _pad_mlp_input(tensor: torch.Tensor, suffix: str) -> torch.Tensor:
+    output_size, old_input, added = 5120, 17408, 256
+    if suffix == "weight_shape":
+        return _shape_tensor(
+            tensor, (output_size, old_input), (output_size, old_input + added)
+        )
+    if suffix == "weight_packed":
+        unit = 8
+    elif suffix in ("weight_scale", "weight_zero_point"):
+        unit = 128
+    elif suffix == "weight":
+        unit = 1
+    else:
+        raise ValueError(f"unsupported TP3 MLP input tensor: {suffix}")
+    rows = output_size // (8 if suffix == "weight_zero_point" else 1)
+    if tensor.shape != (rows, old_input // unit):
+        raise ValueError(f"unexpected TP3 MLP input shape: {tensor.shape}")
+    fill = 1 if suffix == "weight_scale" else 0
+    pad = tensor.new_full((rows, added // unit), fill)
+    return torch.cat((tensor, pad), dim=1)
+
+
+def replicate_tp3_heads(
+    weights: Iterable[tuple[str, torch.Tensor]],
+    layer_types: list[str],
+    *,
+    require_complete: bool = True,
+) -> Iterator[tuple[str, torch.Tensor]]:
+    """Expand one checkpoint tensor at a time; leave every other tensor alone."""
+    seen_shapes: set[tuple[int, str]] = set()
+    seen_dense: set[tuple[int, str]] = set()
+    for name, tensor in weights:
+        parts = name.split(".")
+        if parts[:3] != ["model", "language_model", "layers"] or len(parts) < 6:
+            yield name, tensor
+            continue
+        layer = int(parts[3])
+        if not 0 <= layer < len(layer_types):
+            raise ValueError(f"unexpected layer in TP3 checkpoint: {name}")
+        branch = parts[4]
+        projection = parts[5]
+        suffix = parts[6] if len(parts) == 7 else None
+        transform = None
+        if branch == "self_attn" and layer_types[layer] == "full_attention":
+            rows: dict[str, tuple[tuple[int, int], ...]] = {
+                "q_proj": ((12288, 6144),),  # Q and output gate, 512/head.
+                "k_proj": ((1024, 512),),
+                "v_proj": ((1024, 512),),
+            }
+            if projection in rows and suffix is not None:
+                transform = _repeat_output(
+                    tensor, suffix, 5120, rows[projection], dense_tail=(5120,)
+                )
+            elif projection == "o_proj" and suffix is not None:
+                transform = _repeat_input(tensor, suffix, 5120, 6144, 3072)
+        elif branch == "linear_attn" and layer_types[layer] == "linear_attention":
+            rows = {
+                "in_proj_qkv": ((2048, 256), (2048, 256), (6144, 768)),
+                "in_proj_z": ((6144, 768),),
+                "in_proj_a": ((48, 6),),
+                "in_proj_b": ((48, 6),),
+                "conv1d": ((2048, 256), (2048, 256), (6144, 768)),
+            }
+            if projection in rows and suffix is not None:
+                bits = 8 if projection in ("in_proj_qkv", "in_proj_z") else 4
+                dense_tail = (1, 4) if projection == "conv1d" else (5120,)
+                transform = _repeat_output(
+                    tensor,
+                    suffix,
+                    5120,
+                    rows[projection],
+                    bits,
+                    dense_tail=dense_tail,
+                )
+            elif projection == "out_proj" and suffix is not None:
+                transform = _repeat_input(tensor, suffix, 5120, 6144, 768)
+            elif projection in ("A_log", "dt_bias") and suffix is None:
+                transform = _repeat_output(
+                    tensor, "weight", 1, ((48, 6),), dense_tail=()
+                )
+        elif branch == "mlp" and suffix is not None:
+            if projection in ("gate_proj", "up_proj"):
+                transform = _pad_mlp_output(tensor, suffix)
+            elif projection == "down_proj":
+                transform = _pad_mlp_input(tensor, suffix)
+        if transform is None:
+            yield name, tensor
+            continue
+        if suffix == "weight_shape":
+            seen_shapes.add((layer, projection))
+        if branch == "linear_attn" and (
+            (projection in ("in_proj_a", "in_proj_b", "conv1d") and suffix == "weight")
+            or (projection in ("A_log", "dt_bias") and suffix is None)
+        ):
+            seen_dense.add((layer, projection))
+        yield name, transform
+
+    if not require_complete:
+        return
+    expected_shapes = {
+        (layer, projection)
+        for layer, kind in enumerate(layer_types)
+        for projection in (
+            ("q_proj", "k_proj", "v_proj", "o_proj")
+            if kind == "full_attention"
+            else ("in_proj_qkv", "in_proj_z", "out_proj")
+        )
+    }
+    expected_shapes.update(
+        (layer, projection)
+        for layer in range(len(layer_types))
+        for projection in ("gate_proj", "up_proj", "down_proj")
+    )
+    missing = expected_shapes - seen_shapes
+    if missing:
+        raise ValueError(f"TP3 checkpoint is missing packed projections: {missing}")
+    expected_dense = {
+        (layer, projection)
+        for layer, kind in enumerate(layer_types)
+        if kind == "linear_attention"
+        for projection in ("in_proj_a", "in_proj_b", "conv1d", "A_log", "dt_bias")
+    }
+    missing_dense = expected_dense - seen_dense
+    if missing_dense:
+        raise ValueError(f"TP3 checkpoint is missing GDN tensors: {missing_dense}")
