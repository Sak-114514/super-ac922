diff --git a/vllm/model_executor/models/qwen3_5_tp3_heads.py b/vllm/model_executor/models/qwen3_5_tp3_heads.py
index c862ff12c..3023471a4 100644
--- a/vllm/model_executor/models/qwen3_5_tp3_heads.py
+++ b/vllm/model_executor/models/qwen3_5_tp3_heads.py
@@ -276,3 +276,40 @@ def replicate_tp3_heads(
     missing_dense = expected_dense - seen_dense
     if missing_dense:
         raise ValueError(f"TP3 checkpoint is missing GDN tensors: {missing_dense}")
+
+
+def replicate_tp3_mtp_weights(
+    weights: Iterable[tuple[str, torch.Tensor]],
+) -> Iterator[tuple[str, torch.Tensor]]:
+    """Apply the target's exact full-attention/MLP surgery to MTP layer zero."""
+    prefix = "mtp.layers.0."
+    expected = {
+        "self_attn.q_proj.weight",
+        "self_attn.k_proj.weight",
+        "self_attn.v_proj.weight",
+        "self_attn.o_proj.weight",
+        "mlp.gate_proj.weight",
+        "mlp.up_proj.weight",
+        "mlp.down_proj.weight",
+    }
+    seen: set[str] = set()
+    for name, tensor in weights:
+        if not name.startswith(prefix):
+            yield name, tensor
+            continue
+        suffix = name[len(prefix) :]
+        if suffix not in expected:
+            yield name, tensor
+            continue
+        if suffix in seen:
+            raise ValueError(f"duplicate TP3 MTP tensor: {name}")
+        seen.add(suffix)
+        virtual_name = f"model.language_model.layers.0.{suffix}"
+        transformed = replicate_tp3_heads(
+            [(virtual_name, tensor)], ["full_attention"], require_complete=False
+        )
+        _, expanded = next(transformed)
+        yield name, expanded
+    missing = expected - seen
+    if missing:
+        raise ValueError(f"TP3 MTP checkpoint is missing tensors: {missing}")
