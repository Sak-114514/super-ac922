+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import math
+import unittest
+from types import SimpleNamespace
+
+import torch
+
+from vllm.v1.core.kv_cache_utils import (
+    _get_kv_cache_groups_uniform_page_size,
+    unify_kv_cache_spec_page_size,
+)
+from vllm.v1.kv_cache_interface import (
+    FullAttentionSpec,
+    MambaSpec,
+    SlidingWindowSpec,
+)
+
+
+def test_tp3_dflash_uses_bounded_common_kv_page():
+    target = FullAttentionSpec(
+        block_size=16,
+        num_kv_heads=2,
+        head_size=256,
+        dtype=torch.float8_e4m3fn,
+    )
+    draft = FullAttentionSpec(
+        block_size=16,
+        num_kv_heads=3,
+        head_size=128,
+        dtype=torch.float16,
+    )
+    specs = {"target": target, "draft": draft}
+    config = SimpleNamespace(
+        speculative_config=SimpleNamespace(
+            draft_model_config=SimpleNamespace(
+                hf_config=SimpleNamespace(ac922_tp3_draft_replication=True)
+            )
+        )
+    )
+    unified = unify_kv_cache_spec_page_size(specs, config)
+    common_page = math.lcm(target.page_size_bytes, draft.page_size_bytes)
+    assert all(spec.page_size_bytes == common_page for spec in unified.values())
+    assert unified["target"].block_size == 48
+    assert unified["draft"].block_size == 32
+    with unittest.TestCase().assertRaises(NotImplementedError):
+        unify_kv_cache_spec_page_size(specs, SimpleNamespace(speculative_config=None))
+
+
+def test_tp3_dflash_groups_have_fewer_fixed_request_blocks():
+    target = FullAttentionSpec(
+        block_size=48,
+        num_kv_heads=2,
+        head_size=256,
+        dtype=torch.float8_e4m3fn,
+    )
+    draft = SlidingWindowSpec(
+        block_size=32,
+        num_kv_heads=3,
+        head_size=128,
+        dtype=torch.float16,
+        sliding_window=2048,
+    )
+    mamba = MambaSpec(
+        block_size=48,
+        shapes=((12288,),),
+        dtypes=(torch.float32,),
+        page_size_padded=target.page_size_bytes,
+    )
+    assert target.page_size_bytes == draft.page_size_bytes == mamba.page_size_bytes
+    specs = {
+        **{f"draft.{i}": draft for i in range(5)},
+        **{f"target.{i}": target for i in range(16)},
+        **{f"mamba.{i}": mamba for i in range(48)},
+    }
+    config = SimpleNamespace(
+        speculative_config=SimpleNamespace(
+            draft_model_config=SimpleNamespace(
+                hf_config=SimpleNamespace(ac922_tp3_draft_replication=True)
+            )
+        )
+    )
+    assert len(_get_kv_cache_groups_uniform_page_size(specs)) == 9
+    assert len(_get_kv_cache_groups_uniform_page_size(specs, config)) == 5
+
+
+if __name__ == "__main__":
+    test_tp3_dflash_uses_bounded_common_kv_page()
+    print("PASS test_tp3_dflash_uses_bounded_common_kv_page")
+    test_tp3_dflash_groups_have_fewer_fixed_request_blocks()
+    print("PASS test_tp3_dflash_groups_have_fewer_fixed_request_blocks")
diff --git a/tests/models/qwen3_5/test_tp3_head_replication.py b/tests/models/qwen3_5/test_tp3_head_replication.py
