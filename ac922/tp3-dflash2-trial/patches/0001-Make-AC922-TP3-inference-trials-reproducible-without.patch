+++ b/tests/models/qwen3_5/test_tp3_head_replication.py
@@ -0,0 +1,325 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import os
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+
+from vllm.model_executor.models.qwen3_5_tp3_heads import (
+    _pad_mlp_input,
+    _pad_mlp_output,
+    _repeat_input,
+    _repeat_output,
+    replicate_tp3_heads,
+    validate_tp3_head_config,
+)
+
+
+def test_attention_gate_and_output_are_equivalent_after_replication():
+    torch.manual_seed(7)
+    q_gate = torch.randn(8, 3, dtype=torch.float64)
+    out = torch.randn(3, 4, dtype=torch.float64)
+    hidden = torch.randn(3, dtype=torch.float64)
+
+    def heads(weight):
+        q, gate = (weight @ hidden).reshape(-1, 2, 2).unbind(-2)
+        return (q * torch.sigmoid(gate)).flatten()
+
+    expanded_q_gate = _repeat_output(q_gate, "weight", 3, ((8, 4),))
+    expanded_out = _repeat_input(out, "weight", 3, 4, 2)
+    torch.testing.assert_close(
+        expanded_out @ heads(expanded_q_gate),
+        out @ heads(q_gate),
+        rtol=0,
+        atol=1e-12,
+    )
+
+
+def test_packed_int4_input_replication_preserves_dequantized_output():
+    torch.manual_seed(11)
+    codes = torch.randint(0, 16, (8, 256), dtype=torch.int32)
+    zero_codes = torch.randint(0, 16, (8, 2), dtype=torch.int32)
+    packed = torch.zeros((8, 32), dtype=torch.int32)
+    zero_packed = torch.zeros((1, 2), dtype=torch.int32)
+    for nibble in range(8):
+        packed |= codes[:, nibble::8] << (4 * nibble)
+        zero_packed[0] |= zero_codes[nibble] << (4 * nibble)
+    scales = torch.tensor([[0.125, 0.25], [0.5, 0.0625]] * 4, dtype=torch.bfloat16)
+
+    def dequant(weight, scale, zero):
+        unpacked = torch.stack(
+            [((weight >> (4 * i)) & 15) for i in range(8)], dim=-1
+        ).reshape(8, -1)
+        zero_unpacked = torch.stack(
+            [((zero[0] >> (4 * i)) & 15) for i in range(8)], dim=0
+        )
+        return (unpacked - zero_unpacked.repeat_interleave(128, dim=1)) * scale.to(
+            torch.float64
+        ).repeat_interleave(128, dim=1)
+
+    new_packed = _repeat_input(packed, "weight_packed", 8, 256, 128)
+    new_scales = _repeat_input(scales, "weight_scale", 8, 256, 128)
+    new_zero = _repeat_input(zero_packed, "weight_zero_point", 8, 256, 128)
+    inputs = torch.randn(256, dtype=torch.float64)
+    expanded_inputs = torch.cat((inputs, inputs[:128]))
+    torch.testing.assert_close(
+        dequant(new_packed, new_scales, new_zero) @ expanded_inputs,
+        dequant(packed, scales, zero_packed) @ inputs,
+        rtol=0,
+        atol=1e-12,
+    )
+
+
+def test_checkpoint_shape_dispatch_and_missing_projection_guard():
+    layer_types = [
+        "full_attention" if layer % 4 == 3 else "linear_attention"
+        for layer in range(64)
+    ]
+    shapes = []
+    for layer, kind in enumerate(layer_types):
+        if kind == "full_attention":
+            projections = {
+                "q_proj": (12288, 5120),
+                "k_proj": (1024, 5120),
+                "v_proj": (1024, 5120),
+                "o_proj": (5120, 6144),
+            }
+            branch = "self_attn"
+        else:
+            projections = {
+                "in_proj_qkv": (10240, 5120),
+                "in_proj_z": (6144, 5120),
+                "out_proj": (5120, 6144),
+            }
+            branch = "linear_attn"
+        for projection, shape in projections.items():
+            name = (
+                f"model.language_model.layers.{layer}.{branch}."
+                f"{projection}.weight_shape"
+            )
+            shapes.append((name, torch.tensor(shape)))
+
+    expanded = dict(replicate_tp3_heads(shapes, layer_types, require_complete=False))
+    assert expanded[shapes[0][0]].tolist() == [11520, 5120]
+    full_q = "model.language_model.layers.3.self_attn.q_proj.weight_shape"
+    assert expanded[full_q].tolist() == [18432, 5120]
+    full_out = "model.language_model.layers.3.self_attn.o_proj.weight_shape"
+    assert expanded[full_out].tolist() == [5120, 9216]
+    with unittest.TestCase().assertRaisesRegex(
+        ValueError, "missing packed projections"
+    ):
+        list(replicate_tp3_heads(shapes[:-1], layer_types))
+
+
+def test_missing_dense_gdn_tensor_fails_closed():
+    prefix = "model.language_model.layers.0.linear_attn"
+    shapes = (
+        ("in_proj_qkv", (10240, 5120)),
+        ("in_proj_z", (6144, 5120)),
+        ("out_proj", (5120, 6144)),
+    )
+    weights = [
+        (f"{prefix}.{projection}.weight_shape", torch.tensor(shape))
+        for projection, shape in shapes
+    ]
+    mlp_prefix = "model.language_model.layers.0.mlp"
+    weights.extend(
+        (f"{mlp_prefix}.{projection}.weight_shape", torch.tensor(shape))
+        for projection, shape in (
+            ("gate_proj", (17408, 5120)),
+            ("up_proj", (17408, 5120)),
+            ("down_proj", (5120, 17408)),
+        )
+    )
+    with unittest.TestCase().assertRaisesRegex(ValueError, "missing GDN tensors"):
+        list(replicate_tp3_heads(weights, ["linear_attention"]))
+    bad = [(f"{prefix}.in_proj_a.weight", torch.zeros(48, 1))]
+    with unittest.TestCase().assertRaisesRegex(ValueError, "unexpected dense shape"):
+        list(replicate_tp3_heads(bad, ["linear_attention"], require_complete=False))
+
+
+def test_mlp_padding_adds_only_zero_neurons_and_zero_input_weights():
+    gate_scale = torch.full((17408, 40), 0.25, dtype=torch.bfloat16)
+    down_scale = torch.full((5120, 136), 0.125, dtype=torch.bfloat16)
+    new_gate = _pad_mlp_output(gate_scale, "weight_scale")
+    new_down = _pad_mlp_input(down_scale, "weight_scale")
+    assert new_gate.shape == (17664, 40)
+    assert new_down.shape == (5120, 138)
+    assert torch.equal(new_gate[:17408], gate_scale)
+    assert torch.all(new_gate[17408:] == 1)
+    assert torch.equal(new_down[:, :136], down_scale)
+    assert torch.all(new_down[:, 136:] == 1)
+    assert _pad_mlp_output(torch.tensor([17408, 5120]), "weight_shape").tolist() == [
+        17664,
+        5120,
+    ]
+    assert _pad_mlp_input(torch.tensor([5120, 17408]), "weight_shape").tolist() == [
+        5120,
+        17664,
+    ]
+
+
+def test_top_level_model_loader_applies_replication_before_mapping():
+    import vllm.model_executor.models.qwen3_5 as qwen35
+
+    text = SimpleNamespace(
+        num_attention_heads=36,
+        num_key_value_heads=6,
+        head_dim=256,
+        linear_num_key_heads=18,
+        linear_num_value_heads=54,
+        linear_key_head_dim=128,
+        linear_value_head_dim=128,
+        hidden_size=5120,
+        intermediate_size=17664,
+        attn_output_gate=True,
+        layer_types=[
+            "full_attention" if layer % 4 == 3 else "linear_attention"
+            for layer in range(64)
+        ],
+    )
+    model = qwen35.Qwen3_5ForConditionalGeneration.__new__(
+        qwen35.Qwen3_5ForConditionalGeneration
+    )
+    torch.nn.Module.__init__(model)
+    model.config = SimpleNamespace(ac922_tp3_head_replication=True, text_config=text)
+
+    def check_loader(weights, mapper):
+        assert mapper is model.hf_to_vllm_mapper
+        name, shape = next(iter(weights))
+        assert name == "model.language_model.layers.3.self_attn.q_proj.weight_shape"
+        assert shape.tolist() == [18432, 5120]
+        return {"head-replication-applied"}
+
+    with patch.object(qwen35, "AutoWeightsLoader") as loader:
+        loader.return_value.load_weights.side_effect = check_loader
+        result = model.load_weights(
+            [
+                (
+                    "model.language_model.layers.3.self_attn.q_proj.weight_shape",
+                    torch.tensor([12288, 5120]),
+                )
+            ]
+        )
+    assert result == {"head-replication-applied"}
+
+
+def test_config_requires_exact_target_head_layout():
+    text = SimpleNamespace(
+        num_attention_heads=36,
+        num_key_value_heads=6,
+        head_dim=256,
+        linear_num_key_heads=18,
+        linear_num_value_heads=54,
+        linear_key_head_dim=128,
+        linear_value_head_dim=128,
+        hidden_size=5120,
+        intermediate_size=17664,
+        attn_output_gate=True,
+        layer_types=[
+            "full_attention" if layer % 4 == 3 else "linear_attention"
+            for layer in range(64)
+        ],
+    )
+    assert len(validate_tp3_head_config(SimpleNamespace(text_config=text))) == 64
+    text.num_key_value_heads = 4
+    with unittest.TestCase().assertRaisesRegex(ValueError, "num_key_value_heads=6"):
+        validate_tp3_head_config(SimpleNamespace(text_config=text))
+
+
+def test_real_checkpoint_sample_without_full_weight_scan():
+    import json
+    from collections import defaultdict
+    from pathlib import Path
+
+    from safetensors import safe_open
+
+    if not (model_path := os.environ.get("AC922_TP3_TEST_MODEL")):
+        raise unittest.SkipTest("set AC922_TP3_TEST_MODEL for the real checkpoint")
+    model = Path(model_path)
+    config = json.loads((model / "config.json").read_text())
+    layer_types = config["text_config"]["layer_types"]
+    index = json.loads((model / "model.safetensors.index.json").read_text())
+    weight_map = index["weight_map"]
+    wanted = set()
+    for layer, kind in enumerate(layer_types):
+        branch = "self_attn" if kind == "full_attention" else "linear_attn"
+        projections = (
+            ("q_proj", "k_proj", "v_proj", "o_proj")
+            if kind == "full_attention"
+            else ("in_proj_qkv", "in_proj_z", "out_proj")
+        )
+        for projection in projections:
+            wanted.add(
+                f"model.language_model.layers.{layer}.{branch}."
+                f"{projection}.weight_shape"
+            )
+    assert len(wanted) == 208
+    q_prefix = "model.language_model.layers.3.self_attn.q_proj"
+    gdn_prefix = "model.language_model.layers.0.linear_attn.out_proj"
+    mlp_prefix = "model.language_model.layers.0.mlp"
+    samples = {
+        f"{q_prefix}.weight_packed",
+        f"{q_prefix}.weight_zero_point",
+        f"{gdn_prefix}.weight_scale",
+        f"{gdn_prefix}.weight_zero_point",
+        f"{mlp_prefix}.gate_proj.weight_scale",
+        f"{mlp_prefix}.down_proj.weight_scale",
+        f"{mlp_prefix}.gate_proj.weight_shape",
+        f"{mlp_prefix}.down_proj.weight_shape",
+    }
+    by_file = defaultdict(list)
+    for name in wanted | samples:
+        by_file[weight_map[name]].append(name)
+    weights = {}
+    for shard, names in by_file.items():
+        with safe_open(str(model / shard), framework="pt", device="cpu") as handle:
+            for name in names:
+                weights[name] = handle.get_tensor(name)
+
+    expanded = dict(
+        replicate_tp3_heads(weights.items(), layer_types, require_complete=False)
+    )
+    packed = weights[f"{q_prefix}.weight_packed"]
+    assert expanded[f"{q_prefix}.weight_packed"].shape == (18432, 640)
+    assert torch.equal(expanded[f"{q_prefix}.weight_packed"][12288:], packed[:6144])
+    zero = weights[f"{q_prefix}.weight_zero_point"]
+    assert torch.equal(expanded[f"{q_prefix}.weight_zero_point"][1536:], zero[:768])
+    scale = weights[f"{gdn_prefix}.weight_scale"]
+    new_scale = expanded[f"{gdn_prefix}.weight_scale"]
+    assert new_scale.shape == (5120, 54)
+    assert torch.equal(new_scale[:, :6] * 2, scale[:, :6])
+    assert torch.equal(new_scale[:, 6:48], scale[:, 6:])
+    assert torch.equal(new_scale[:, 48:], new_scale[:, :6])
+    zero = weights[f"{gdn_prefix}.weight_zero_point"]
+    assert torch.equal(expanded[f"{gdn_prefix}.weight_zero_point"][:, 48:], zero[:, :6])
+    assert expanded[f"{mlp_prefix}.gate_proj.weight_shape"].tolist() == [
+        17664,
+        5120,
+    ]
+    assert expanded[f"{mlp_prefix}.down_proj.weight_shape"].tolist() == [
+        5120,
+        17664,
+    ]
+    assert torch.all(expanded[f"{mlp_prefix}.gate_proj.weight_scale"][17408:] == 1)
+    assert torch.all(expanded[f"{mlp_prefix}.down_proj.weight_scale"][:, 136:] == 1)
+
+
+if __name__ == "__main__":
+    for test in (
+        test_attention_gate_and_output_are_equivalent_after_replication,
+        test_packed_int4_input_replication_preserves_dequantized_output,
+        test_checkpoint_shape_dispatch_and_missing_projection_guard,
+        test_missing_dense_gdn_tensor_fails_closed,
+        test_mlp_padding_adds_only_zero_neurons_and_zero_input_weights,
+        test_top_level_model_loader_applies_replication_before_mapping,
+        test_config_requires_exact_target_head_layout,
+    ):
+        test()
+        print(f"PASS {test.__name__}")
+    if os.environ.get("AC922_TP3_TEST_MODEL"):
+        test_real_checkpoint_sample_without_full_weight_scan()
+        print("PASS test_real_checkpoint_sample_without_full_weight_scan")
